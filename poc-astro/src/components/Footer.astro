    <div class="flex items-center gap-4">
      <span>© {year} PrestaEdit</span>
      <a href={githubUrl} aria-label="GitHub PrestaEdit" class="text-gray-500 transition hover:text-gray-900">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
