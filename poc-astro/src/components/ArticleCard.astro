---
interface Props {
  href: string;
  title: string;
  summary?: string;
  date: Date;
  tags: string[];
  author: string;
  featuredimg?: string;
  series?: string;
  seriesIndex?: number;
  seriesTotal?: number;
  draft?: boolean;
}
const {
  href, title, summary, date, tags, author, featuredimg,
  series, seriesIndex, seriesTotal, draft,
} = Astro.props;
import { chipClass, placeholderFor } from '../lib/palette';

const formatted = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const fallback = placeholderFor(tags);
const src = featuredimg ?? fallback;
const slug = href.split('/').filter(Boolean).pop();
const heroName = `hero-${slug}`;
const titleName = `title-${slug}`;
const metaName = `meta-${slug}`;
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:border-blue-500/50 hover:shadow-lg">
  <a href={href} class="relative block aspect-[1200/630] overflow-hidden bg-gray-100">
    <img
      src={src}
      alt={title}
      transition:name={heroName}
      class="h-full w-full object-cover transition group-hover:scale-105"
      loading="lazy"
      data-fallback={fallback}
      onerror={`this.onerror=null;this.src='${fallback}';`}
    />
    {series && (
      <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/>
        </svg>
        Série {series.charAt(0).toUpperCase() + series.slice(1)}
        {seriesIndex && seriesTotal && <span class="opacity-80"> · {seriesIndex}/{seriesTotal}</span>}
      </span>
    )}
    {draft === true && (
      <span
        class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-amber-500 px-2 py-1 text-xs font-semibold text-white shadow-sm"
        title="Brouillon (non publié en production)"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.04a1 1 0 0 0 0-1.41l-2.51-2.51a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 2-1.66z"/>
        </svg>
        Brouillon
      </span>
    )}
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap gap-2">
      {tags.slice(0, 3).map((t) => (
        <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', chipClass(t)]}>{t}</span>
      ))}
    </div>
    <h3 transition:name={titleName} class="text-lg font-semibold text-gray-900 group-hover:text-blue-600">
      <a href={href}>{title}</a>
    </h3>
    {summary && <p class="mt-2 line-clamp-3 text-sm text-gray-600">{summary}</p>}
    <div transition:name={metaName} class="mt-4 flex items-center gap-3 text-xs text-gray-500">
      <span>{author}</span>
      <span aria-hidden="true">•</span>
      <time datetime={date.toISOString()}>{formatted}</time>
    </div>
  </div>
</article>
