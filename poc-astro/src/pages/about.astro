---
import BaseLayout from '../layouts/BaseLayout.astro';

const githubUrl = 'https://github.com/PrestaEdit';
const linkedinUrl = 'https://www.linkedin.com/in/jonathan-danse/';
const siteUrl = 'https://prestaedit.com';
const bookUrl = 'https://www.editions-eni.fr/livre/developpez-avec-php-pour-prestashop-9782409040009';

const stats = [
  { value: '15+ ans', label: 'de dev PrestaShop' },
  { value: '477', label: 'pull requests' },
  { value: '749', label: 'commits' },
  { value: '1', label: 'livre publié' },
];

const skills = [
  'Modules & thèmes sur-mesure',
  'Contribution core PrestaShop',
  'Tests automatisés (PrestaFlow)',
  'CI/CD & maintenance',
  'Formation & consulting',
  'API d\'administration',
];
---
<BaseLayout title="À propos" description="Le blog technique de Jonathan Danse (PrestaEdit).">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">À propos</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900">PrestaShop, sous le capot.</h1>
    <p class="mt-6 text-lg text-gray-600">
      Ce blog est le carnet technique de Jonathan Danse (<a href={siteUrl} class="font-medium text-blue-600 hover:underline">prestaedit.com</a>) —
      articles courts qui montrent du code qui tourne, autour de PrestaShop.
      Pas d'avis produit, pas de contenu marketing.
    </p>

    <div class="mt-10 rounded-2xl border border-gray-200 p-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <div class="flex h-20 w-20 flex-none items-center justify-center rounded-full bg-blue-600 text-2xl font-semibold text-white">JD</div>
        <div>
          <p class="text-xl font-semibold text-gray-900">Jonathan Danse</p>
          <p class="mt-0.5 text-sm text-gray-500">Développeur PHP / PrestaShop · Belgique · full remote</p>
          <p class="mt-3 text-sm text-gray-600">
            Sur PrestaShop depuis 2010, contributeur open-source depuis 2012
            (statut « Top Contributor »), auteur de
            <a href={bookUrl} class="font-medium text-blue-600 hover:underline">Développez avec PHP pour PrestaShop</a>
            (Éditions ENI, 2023), intervenant récurrent à la PrestaShop Developer Conference.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={siteUrl} class="inline-flex items-center gap-2 rounded-md border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
              prestaedit.com
            </a>
            <a href={githubUrl} class="inline-flex items-center gap-2 rounded-md border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.72 0-1.26.45-2.3 1.19-3.11-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.79 0c2.21-1.5 3.18-1.19 3.18-1.19.63 1.59.23 2.77.11 3.06.74.81 1.19 1.85 1.19 3.11 0 4.45-2.69 5.43-5.25 5.71.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
              GitHub
            </a>
            <a href={linkedinUrl} class="inline-flex items-center gap-2 rounded-md border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.44c.99 0 1.79-.77 1.79-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="rounded-xl border border-gray-200 p-4 text-center">
          <p class="text-2xl font-bold text-gray-900">{s.value}</p>
          <p class="mt-1 text-xs text-gray-500">{s.label}</p>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <h2 class="text-xl font-semibold text-gray-900">Ce que vous trouverez ici</h2>
      <p class="mt-3 text-gray-600">
        Le blog est le pendant technique de prestaedit.com : notes de terrain sur ce que je
        construis (souvent open-source), les outils qui m'aident et les pièges rencontrés.
      </p>
      <ul class="mt-4 grid grid-cols-1 gap-2 text-sm text-gray-700 sm:grid-cols-2">
        {skills.map((s) => (
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 flex-none text-emerald-600" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            {s}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-gray-200 p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Séries</p>
        <p class="mt-2 text-sm text-gray-600">Suites d'articles autour d'un outil ou d'un workflow.</p>
        <a href="/series" class="mt-3 inline-block text-sm font-medium text-blue-600 hover:underline">Voir les séries →</a>
      </div>
      <div class="rounded-xl border border-gray-200 p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Une mission ?</p>
        <p class="mt-2 text-sm text-gray-600">Développement, tests, formation, audit — les demandes passent par prestaedit.com.</p>
        <a href={siteUrl} class="mt-3 inline-block text-sm font-medium text-blue-600 hover:underline">Aller sur prestaedit.com →</a>
      </div>
    </div>
  </section>
</BaseLayout>
