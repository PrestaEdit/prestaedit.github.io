---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { slugify } from '../../lib/slug';
import { chipClass, accentFor } from '../../lib/palette';

type Entry = {
  label: string;
  count: number;
  latest: Date;
  posts: { id: string; title: string; date: Date }[];
};

const posts = await getPublishedPosts();
const grouped = new Map<string, Entry>();
for (const p of posts) {
  for (const t of p.data.tags) {
    const key = slugify(t);
    const entry = grouped.get(key);
    const item = { id: p.id, title: p.data.title, date: p.data.date };
    if (entry) {
      entry.count += 1;
      entry.posts.push(item);
      if (p.data.date > entry.latest) entry.latest = p.data.date;
      // On garde la casse la plus « riche » rencontrée (PrestaFlow plutôt que prestaflow).
      const upper = (s: string) => [...s].filter((c) => c >= 'A' && c <= 'Z').length;
      if (upper(t) > upper(entry.label)) entry.label = t;
    } else {
      grouped.set(key, { label: t, count: 1, latest: p.data.date, posts: [item] });
    }
  }
}

const tags = [...grouped.entries()]
  .map(([slug, e]) => ({
    slug,
    label: e.label,
    count: e.count,
    latest: e.latest,
    recent: [...e.posts].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 3),
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const totalTagged = posts.length;
---
<BaseLayout title="Tags" description="Explorer les articles du blog PrestaEdit par mot-clé.">
  <section class="border-b border-gray-200 bg-gradient-to-b from-gray-50 to-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Explorer</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Tags</h1>
      <p class="mt-4 max-w-2xl text-lg text-gray-600">
        Chaque article est rangé par mot-clé : l'outillage et les tests d'un côté,
        les versions de PrestaShop de l'autre, les annonces et les conférences à part.
        Choisissez une entrée pour ne voir que ce qui s'y rapporte.
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Mots-clés</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{tags.length}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Articles</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{totalTagged}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Dernier publié</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{fmt(tags[0]?.latest ?? new Date())}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tags.map(({ slug, label, count, latest, recent }) => {
        const accent = accentFor(label);
        return (
          <article
            class:list={[
              'group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:shadow-lg',
              accent.hover,
            ]}
          >
            <span class:list={['h-1 w-full flex-none', accent.bar]} />
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold text-gray-900">
                  <a href={`/tags/${slug}`} class="after:absolute after:inset-0">{label}</a>
                </h2>
                <span class:list={['inline-flex flex-none items-center rounded-full px-2.5 py-1 text-xs font-semibold', chipClass(label)]}>
                  {count}
                </span>
              </div>
              <p class="mt-1 text-xs text-gray-500">Dernier article le {fmt(latest)}</p>

              <ul class="mt-4 flex-1 space-y-2 border-t border-gray-100 pt-4">
                {recent.map((r) => (
                  <li class="line-clamp-2 text-sm leading-snug text-gray-600">{r.title}</li>
                ))}
              </ul>

              <p class:list={['mt-5 text-sm font-semibold', accent.text]}>
                Voir {count === 1 ? "l'article" : `les ${count} articles`}
                <span class="inline-block transition group-hover:translate-x-1"> →</span>
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="border-t border-gray-200 bg-gray-50">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500">Tous les mots-clés</h2>
      <ul class="mt-5 flex flex-wrap gap-3">
        {tags.map(({ slug, label, count }) => (
          <li>
            <a
              href={`/tags/${slug}`}
              class:list={[
                'inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition hover:brightness-95',
                chipClass(label),
              ]}
            >
              {label}
              <span class="rounded-full bg-white/60 px-2 py-0.5 text-xs">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
