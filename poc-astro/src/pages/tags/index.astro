---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import { slugify } from '../../lib/slug';
import { chipClass } from '../../lib/palette';

const posts = await getPublishedPosts();
const grouped = new Map<string, { label: string; count: number }>();
for (const p of posts) {
  for (const t of p.data.tags) {
    const key = slugify(t);
    const entry = grouped.get(key);
    if (entry) {
      entry.count += 1;
      // Prefer the label with more uppercase letters (usually the "canonical" branded form)
      const upper = (s: string) => [...s].filter((c) => c >= 'A' && c <= 'Z').length;
      if (upper(t) > upper(entry.label)) entry.label = t;
    } else {
      grouped.set(key, { label: t, count: 1 });
    }
  }
}
const tags = [...grouped.entries()]
  .map(([slug, { label, count }]) => ({ slug, label, count }))
  .sort((a, b) => b.count - a.count);
---
<BaseLayout title="Tags">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-gray-900">Tags</h1>
    <p class="mt-2 text-gray-600">Explorer les articles par mot-clé.</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {tags.map(({ slug, label, count }) => (
        <li>
          <a
            href={`/tags/${slug}`}
            class:list={[
              'inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition hover:brightness-95',
              chipClass(label),
            ]}
          >
            {label}
            <span class="rounded-full bg-white/60 px-2 py-0.5 text-xs">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
