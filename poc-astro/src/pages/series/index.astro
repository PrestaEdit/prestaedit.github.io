---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { accentFor, chipClass } from '../../lib/palette';
import { seriesLabel } from '../../lib/series';

const posts = await getPublishedPosts();

type Item = { id: string; title: string; date: Date };
const map = new Map<string, { items: Item[]; tags: string[] }>();
for (const p of posts) {
  if (!p.data.series) continue;
  const entry = map.get(p.data.series) ?? { items: [], tags: p.data.tags };
  entry.items.push({ id: p.id, title: p.data.title, date: p.data.date });
  entry.tags = p.data.tags;
  map.set(p.data.series, entry);
}

const series = [...map.entries()]
  .map(([slug, e]) => {
    const chrono = [...e.items].sort((a, b) => a.date.valueOf() - b.date.valueOf());
    const latestPost = chrono[chrono.length - 1];
    return {
      slug,
      label: seriesLabel(slug),
      tags: e.tags,
      count: chrono.length,
      first: chrono[0],
      latest: latestPost,
      recent: [...chrono].reverse().slice(0, 4),
    };
  })
  .sort((a, b) => b.latest.date.valueOf() - a.latest.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmtShort = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const totalInSeries = series.reduce((n, s) => n + s.count, 0);
---
<BaseLayout title="Séries" description="Les suites d'articles du blog PrestaEdit, à lire dans l'ordre.">
  <section class="border-b border-gray-200 bg-gradient-to-b from-gray-50 to-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Parcourir</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Séries</h1>
      <p class="mt-4 max-w-2xl text-lg text-gray-600">
        Certains sujets ne tiennent pas en un article. Les séries les déroulent dans
        l'ordre, du premier pas jusqu'aux cas tordus — chacune se lit d'affilée ou
        se picore au besoin.
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Séries</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{series.length}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Articles</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{totalInSeries}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Dernier publié</dt>
          <dd class="mt-1 text-2xl font-bold text-gray-900">{fmtShort(series[0]?.latest.date ?? new Date())}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl space-y-8 px-4 py-14">
    {series.map((s) => {
      const accent = accentFor(s.tags[0] ?? '');
      return (
        <article class:list={['overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:shadow-lg', accent.hover]}>
          <div class:list={['relative flex h-36 items-end overflow-hidden px-6 sm:h-44 sm:px-8', accent.bar]}>
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/25 to-transparent" />
            <h2 class="relative pb-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">
              <a href={`/series/${s.slug}`} class="transition hover:text-white/80">{s.label}</a>
            </h2>
          </div>
          <div>
            <div class="p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-blue-600">Série</span>
                <span class:list={['inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold', chipClass(s.tags[0] ?? '')]}>
                  {s.count} articles
                </span>
              </div>
              <p class="mt-3 text-sm text-gray-500">
                Du {fmt(s.first.date)} au {fmt(s.latest.date)}
              </p>

              <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-gray-500">Derniers publiés</h3>
              <ul class="mt-3 space-y-2 border-t border-gray-100 pt-3">
                {s.recent.map((r) => (
                  <li class="flex gap-3 text-sm">
                    <span class="flex-none tabular-nums text-gray-400">{fmtShort(r.date)}</span>
                    <a href={`/blog/${r.id}`} class="line-clamp-1 text-gray-700 hover:text-blue-600">{r.title}</a>
                  </li>
                ))}
              </ul>

              <div class="mt-7 flex flex-wrap gap-3">
                <a
                  href={`/blog/${s.first.id}`}
                  class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700"
                >
                  Commencer par le début
                </a>
                <a
                  href={`/series/${s.slug}`}
                  class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
                >
                  Voir les {s.count} articles
                </a>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
