---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import { placeholderFor } from '../../lib/palette';

const posts = await getPublishedPosts();
const map = new Map<string, { count: number; latest: Date; cover?: string; tags: string[] }>();
for (const p of posts) {
  if (!p.data.series) continue;
  const entry = map.get(p.data.series) ?? { count: 0, latest: new Date(0), cover: p.data.featuredimg, tags: p.data.tags };
  entry.count += 1;
  if (p.data.date > entry.latest) {
    entry.latest = p.data.date;
    entry.cover = p.data.featuredimg ?? entry.cover;
    entry.tags = p.data.tags;
  }
  map.set(p.data.series, entry);
}
const series = [...map.entries()].sort((a, b) => b[1].latest.valueOf() - a[1].latest.valueOf());
---
<BaseLayout title="Séries">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-gray-900">Séries</h1>
    <p class="mt-2 text-gray-600">Suites d'articles autour d'un même thème.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {series.map(([slug, meta]) => (
        <a href={`/series/${slug}`} class="group flex overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:border-blue-500/50 hover:shadow-lg">
          <img
            src={meta.cover ?? placeholderFor(meta.tags)}
            alt=""
            class="hidden aspect-square w-40 flex-none object-cover sm:block"
            onerror={`this.onerror=null;this.src='${placeholderFor(meta.tags)}';`}
          />
          <div class="flex flex-1 flex-col justify-center p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Série</p>
            <h2 class="mt-1 text-lg font-semibold text-gray-900 group-hover:text-blue-600">{slug.charAt(0).toUpperCase() + slug.slice(1)}</h2>
            <p class="mt-2 text-sm text-gray-500">{meta.count} article{meta.count > 1 ? 's' : ''} · dernier {meta.latest.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
