---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const map = new Map<string, typeof posts>();
  for (const p of posts) {
    if (!p.data.series) continue;
    if (!map.has(p.data.series)) map.set(p.data.series, []);
    map.get(p.data.series)!.push(p);
  }
  return [...map.entries()].map(([slug, items]) => ({
    params: { slug },
    props: { posts: items.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()) },
  }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`Série : ${slug}`}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Série</p>
    <h1 class="mt-2 text-4xl font-bold text-gray-900">{slug}</h1>
    <p class="mt-3 text-gray-600">{posts.length} article{posts.length > 1 ? 's' : ''} — à lire dans l'ordre.</p>

    <ol class="mt-10 space-y-4">
      {posts.map((p, i) => (
        <li>
          <a href={`/blog/${p.id}`} class="group flex gap-5 rounded-xl border border-gray-200 bg-white p-5 transition hover:border-blue-500/50 hover:shadow-md">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white">
              {i + 1}
            </span>
            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600">{p.data.title}</h2>
              {p.data.summary && <p class="mt-1 line-clamp-2 text-sm text-gray-600">{p.data.summary}</p>}
              <p class="mt-2 text-xs text-gray-500">{p.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <a href="/series" class="mt-10 inline-block text-sm font-medium text-blue-600 hover:underline">← Toutes les séries</a>
  </section>
</BaseLayout>
